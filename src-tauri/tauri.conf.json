{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agents Dashboard",
  "version": "0.5.4",
  "identifier": "io.github.laomushan.agents-dashboard",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Agents Dashboard",
        "width": 1603,
        "height": 1028,
        "minWidth": 960,
        "minHeight": 640,
        "visible": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}


